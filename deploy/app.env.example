# /etc/agent-guild/app.env（chmod 600、root 所有）。値はここに書き、リポジトリには入れない。
# 例示値・空欄のままでは setup.sh の事前確認とサーバー起動の両方が失敗する。実際の値は推測せず、管理者が決めて入れる。
AGENT_GUILD_ORIGIN=https://agent-guild.example.com
# GitHub OAuth App。callback は https://<ドメイン>/api/auth/callback。
AGENT_GUILD_GITHUB_CLIENT_ID=
AGENT_GUILD_GITHUB_CLIENT_SECRET=
# この GitHub 組織の有効なメンバーだけがログインできる。
AGENT_GUILD_GITHUB_ORG=your-org
# Google OAuth クライアント（ウェブアプリケーション）。callback は https://<ドメイン>/api/auth/google/callback。
# 3つとも必須。一部だけの設定は起動を拒否する。
AGENT_GUILD_GOOGLE_CLIENT_ID=
AGENT_GUILD_GOOGLE_CLIENT_SECRET=
# ログインを許可する Google Workspace の主ドメイン。小文字、カンマ区切り、完全一致（サブドメインは含まない）。
AGENT_GUILD_GOOGLE_DOMAINS=
# 管理者（通報確認・非表示）の GitHub 数値 ID。カンマ区切り。Google アカウントは管理者に指定できない。
AGENT_GUILD_ADMIN_IDS=
# AGENT_GUILD_POST_LIMIT=5
# AGENT_GUILD_POST_WINDOW_MS=60000
